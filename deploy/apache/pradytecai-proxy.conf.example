# Apache / WHM — PradytecAI on shared public_html
#
# cPanel: pradytecai.com DocumentRoot = /home/pradytec/public_html
# Sibling sites (crm/, dashboard/, analyzer/, …) must remain untouched.
# deploy.sh only writes: assets/, index.html, static/, additive media/
#
# Backend: Docker web → 127.0.0.1:8100 (container Gunicorn :8100)

# --- Prefer ProxyPass in VirtualHost include (mod_proxy, mod_proxy_http) ---
#
# ProxyPreserveHost On
# RequestHeader set X-Forwarded-Proto "https"
#
# ProxyPass        /api/v1/  http://127.0.0.1:8100/api/v1/
# ProxyPassReverse /api/v1/  http://127.0.0.1:8100/api/v1/
# ProxyPass        /up       http://127.0.0.1:8100/up
# ProxyPassReverse /up       http://127.0.0.1:8100/up
# ProxyPass        /health   http://127.0.0.1:8100/health
# ProxyPassReverse /health   http://127.0.0.1:8100/health
# ProxyPass        /t/       http://127.0.0.1:8100/t/
# ProxyPassReverse /t/      http://127.0.0.1:8100/t/
# ProxyPass        /login    http://127.0.0.1:8100/login
# ProxyPassReverse /login    http://127.0.0.1:8100/login
# ProxyPass        /admin    http://127.0.0.1:8100/admin
# ProxyPassReverse /admin    http://127.0.0.1:8100/admin
# ProxyPass        /contact  http://127.0.0.1:8100/contact
# ProxyPassReverse /contact  http://127.0.0.1:8100/contact

# --- Optional: SPA fallback in /home/pradytec/public_html/.htaccess ---
# Do NOT use a blanket rewrite that catches /crm /dashboard etc.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   # Real files/dirs (including sibling apps) pass through
#   RewriteCond %{REQUEST_FILENAME} -f [OR]
#   RewriteCond %{REQUEST_FILENAME} -d
#   RewriteRule ^ - [L]
#   # API / health / tracking already proxied above — skip if using ProxyPass
#   RewriteRule ^index\.html$ - [L]
#   RewriteRule . /index.html [L]
# </IfModule>

# Serve from disk:
#   /           → index.html (React SPA)
#   /assets/*   → Vite hashed JS/CSS
#   /static/*   → Django collectstatic
#   /media/*    → uploads
#   /crm/* etc. → existing apps (unchanged)
