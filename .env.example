# =============================================================================
# Django — copy to .env and adjust for local or production
#
# Production WHM (/home/pradytec/pradytecai):
#   Python: /usr/local/bin/python3.12 → venv folder env/  (NEVER /usr/bin/python3)
#   Gunicorn: 127.0.0.1:8100  (port 8000 is used by another app)
#   See docs/PRODUCTION_SERVER.md
# =============================================================================
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string

# Local: true | Production: false
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Production example:
# DEBUG=false
# ALLOWED_HOSTS=pradytecai.com,www.pradytecai.com,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://pradytecai.com,https://www.pradytecai.com

# Gunicorn (production only; ignored by runserver)
GUNICORN_BIND=127.0.0.1:8100
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Local/dev sqlite (do NOT point at database/database.sqlite)
DJANGO_DB_CONNECTION=sqlite
DJANGO_DB_NAME=db.sqlite3
# DJANGO_USE_LARAVEL_SQLITE=false

# MySQL (production / cutover) — uncomment and set:
# DJANGO_DB_CONNECTION=mysql
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=3306
# DJANGO_DB_NAME=pradytecai
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=

SESSION_COOKIE_NAME=pradytecai_django_session
CSRF_COOKIE_NAME=pradytecai_django_csrftoken
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# Production HTTPS behind proxy: SESSION_SECURE_COOKIE=true

# =============================================================================
# Redis (default 6379) + Celery limits (keep light on WHM/VPS)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000
CELERY_BROKER_POOL_LIMIT=5
CELERY_REDIS_MAX_CONNECTIONS=10
CELERY_TASK_DEFAULT_RATE_LIMIT=20/m
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_IGNORE_RESULT=true

# =============================================================================
# Shared / Laravel legacy (keep APP_KEY for encrypted Integration tokens)
# =============================================================================
APP_NAME=PradytecAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Laravel still reads these; Django MySQL cutover can reuse when DJANGO_DB_HOST is set
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pradytecai
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=PradytecAI

BULKSMS_CRM_ENABLED=false
BULKSMS_API_URL=https://crm.pradytecai.com/api
BULKSMS_API_KEY=
BULKSMS_CLIENT_ID=1
BULKSMS_SENDER_ID=

ULTRAMSG_API_URL=https://api.ultramsg.com
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

BUFFER_ENABLED=false
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_ACCESS_TOKEN=

GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
