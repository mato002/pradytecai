# =============================================================================
# PradytecAI environment example
#
# Local Windows: keep sqlite + REDIS_HOST=127.0.0.1
# Production Docker (WHM): PostgreSQL Compose service + host Redis via
#   host.docker.internal — see README.md and docs/PRODUCTION_SERVER.md
#
# Gunicorn runs ONLY inside Docker Compose service `web`.
# pradytec-gunicorn.service / pradytecai-gunicorn.service are NOT used.
# =============================================================================

COMPOSE_PROJECT_NAME=pradytecai
IMAGE_TAG=latest

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string

# Local: true | Production: false
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Production:
# DEBUG=false
# ALLOWED_HOSTS=www.pradytecai.com,pradytecai.com,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://www.pradytecai.com,https://pradytecai.com

# Inside Docker web container Gunicorn binds 0.0.0.0:8100 (internal).
# Host publishes 127.0.0.1:8100:8100 (host :8000 is taken by another app).
GUNICORN_BIND=0.0.0.0:8100
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# =============================================================================
# Database
# =============================================================================

# --- Local sqlite (Windows) ---
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_CONNECTION=sqlite
DJANGO_DB_NAME=db.sqlite3

# --- Production PostgreSQL (Docker Compose service `postgres`) ---
# POSTGRES_DB=pradytecai
# POSTGRES_USER=pradytecai
# POSTGRES_PASSWORD=change-me-strong-password
#
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_CONNECTION=postgresql
# DJANGO_DB_NAME=pradytecai
# DJANGO_DB_USER=pradytecai
# DJANGO_DB_PASSWORD=change-me-strong-password
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# --- Temporary MySQL (migration tooling / rollback only; do not delete MySQL yet) ---
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_CONNECTION=mysql
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=3306
# DJANGO_DB_NAME=pradytec_prady
# DJANGO_DB_USER=pradytec_prady
# DJANGO_DB_PASSWORD=

SESSION_COOKIE_NAME=pradytecai_django_session
CSRF_COOKIE_NAME=pradytecai_django_csrftoken
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# Production HTTPS: SESSION_SECURE_COOKIE=true

# =============================================================================
# Redis — existing HOST Redis (no Redis Compose service by default)
# Local: 127.0.0.1 | Docker: host.docker.internal
# Inspect DB allocations before choosing numbers. Prefer dedicated DBs (e.g. 2/3).
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Local defaults (DB 0/1). Production Docker example (dedicated DBs):
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Production Docker (after confirming DBs 2/3 are free):
# REDIS_HOST=host.docker.internal
# CELERY_BROKER_URL=redis://host.docker.internal:6379/2
# CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/3

CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000
CELERY_BROKER_POOL_LIMIT=5
CELERY_REDIS_MAX_CONNECTIONS=10
CELERY_TASK_DEFAULT_RATE_LIMIT=20/m
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_IGNORE_RESULT=true

# =============================================================================
# Docker resource limits (shared WHM host — protect other apps)
# Tune via `docker stats`; do not remove limits as the default fix.
# =============================================================================
DOCKER_WEB_CPUS=0.75
DOCKER_WEB_MEMORY=512m
DOCKER_WEB_MEM_RESERVATION=256m
DOCKER_WEB_PIDS_LIMIT=150

DOCKER_WORKER_CPUS=0.50
DOCKER_WORKER_MEMORY=384m
DOCKER_WORKER_MEM_RESERVATION=192m
DOCKER_WORKER_PIDS_LIMIT=100

DOCKER_BEAT_CPUS=0.20
DOCKER_BEAT_MEMORY=192m
DOCKER_BEAT_MEM_RESERVATION=96m
DOCKER_BEAT_PIDS_LIMIT=50

DOCKER_POSTGRES_CPUS=1.00
DOCKER_POSTGRES_MEMORY=768m
DOCKER_POSTGRES_MEM_RESERVATION=384m
DOCKER_POSTGRES_PIDS_LIMIT=200

# =============================================================================
# React (browser-visible only — never put server secrets in VITE_*)
# =============================================================================
# Product media videos (MP4/WebM). Application ceiling; raise Apache LimitRequestBody if needed.
PRODUCT_VIDEO_MAX_BYTES=83886080
# DATA_UPLOAD_MAX_MEMORY_SIZE=
# FILE_UPLOAD_MAX_MEMORY_SIZE=

VITE_API_BASE_URL=/api/v1

# cPanel DocumentRoot for pradytecai.com (shared with sibling apps — deploy allowlists only)
PUBLIC_HTML=/home/pradytec/public_html

# =============================================================================
# Legacy APP_KEY — keep while Integration tokens were encrypted by Laravel
# =============================================================================
APP_NAME="PRADY TECHNOLOGIES LTD"
APP_KEY=
APP_URL=http://localhost:8000

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="PRADY TECHNOLOGIES LTD"

BULKSMS_CRM_ENABLED=false
BULKSMS_API_URL=https://crm.pradytecai.com/api
BULKSMS_API_KEY=
BULKSMS_CLIENT_ID=1
BULKSMS_SENDER_ID=

ULTRAMSG_API_URL=https://api.ultramsg.com
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

BUFFER_ENABLED=false
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_ACCESS_TOKEN=

GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
